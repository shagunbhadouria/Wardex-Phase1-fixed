# ==============================================================================
# SentinelAI Environment Variables Configuration (Blueprint v2 Appendix 7.1)
# ==============================================================================

# Database & Broker
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinelai
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Groq & Local Ollama Fallback)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_SMART=llama-3.1-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434

# Authentication & Security
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
GITHUB_WEBHOOK_SECRET=your_32_char_github_webhook_secret

# ML Anomaly Threshold
ANOMALY_THRESHOLD=-0.1

# Autonomous Self-Healing Safety Gates (Rule R-100)
CONFIDENCE_GATE_THRESHOLD=0.82
MIN_HEALING_SUCCESSES=3

# Application & Observability
FRONTEND_URL=http://localhost:3000
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXX
LOG_LEVEL=INFO
ENVIRONMENT=development
